{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // One configuration for every package: every built-in plugin and every
  // category, nursery included, at error. Deviations below are limited to
  // two kinds, each with its reason: a rule turned off because it
  // contradicts another enabled rule or the OpenCode host contract, and an
  // option that declares this repository's environment (globals, test
  // blocks, library constructors, host types) to a rule.
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "jest",
    "vitest",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "rules": {
    // Contradiction: OpenCode loads `default` from the entry modules, and
    // import/no-named-export forbids the only other way to export anything.
    "import/no-default-export": "off",
    // Contradiction: vitest/prefer-importing-vitest-globals requires the
    // opposite. Effect's `it.effect` exists only as an import.
    "vitest/no-importing-vitest-globals": "off",
    // Contradiction: test functions can be imported from one source only, and
    // vitest/prefer-importing-vitest-globals requires that source to be Vitest.
    "jest/prefer-importing-jest-globals": "off",
    // Contradiction: vitest/prefer-strict-boolean-matchers requires
    // `toBe(false)`, which these two require to be `toBeFalsy()`, so no
    // boolean assertion satisfies all three. The strict matcher is kept.
    "vitest/prefer-to-be-falsy": "off",
    "vitest/prefer-to-be-truthy": "off",
    // Contradiction: when a module supplies a value and a type-only symbol,
    // typescript/consistent-type-imports requires `import type` for the
    // symbol and import/consistent-type-specifier-style requires that to be a
    // separate top-level statement. This option permits exactly that form.
    "eslint/no-duplicate-imports": [
      "error",
      { "allowSeparateTypeImports": true }
    ],

    // Environment: Effect constructors are capitalized functions by design
    // (`Schema.Struct(...)`, `Context.Service<...>()`, and the constructors
    // `Data.taggedEnum` returns, such as `Outcome.Transient(...)`), and the
    // Effect rules below require using them. A PascalCase member of a
    // PascalCase owner is such a constructor; bare capitalized calls are
    // still checked.
    "eslint/new-cap": [
      "error",
      {
        "capIsNewExceptionPattern": "^[A-Z][A-Za-z]*\\.[A-Z]"
      }
    ],
    // Environment: a script entry point starts its program with one
    // top-level `NodeRuntime.runMain` call, which these rules otherwise
    // require to sit in a test hook.
    "jest/require-hook": [
      "error",
      { "allowedFunctionCalls": ["NodeRuntime.runMain"] }
    ],
    "vitest/require-hook": [
      "error",
      { "allowedFunctionCalls": ["NodeRuntime.runMain"] }
    ],
    // Environment: `@effect/vitest` test blocks.
    "jest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.effect.each",
          "it.live",
          "layer"
        ]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.effect.each",
          "it.live",
          "layer"
        ]
      }
    ],

    // Environment: Fetch API classes are mutable by definition, and the host
    // hands hooks event objects and editors whose contract is to be mutated
    // in place (`event.request = ...`, `editor.add(...)`), so neither can be
    // declared deeply readonly. The plugin context and options are
    // host-owned handles. Values the host decodes from `@opencode/schema`
    // have readonly fields, but their branded ids carry members the rule
    // cannot prove readonly; each is converted to the plugin's own readonly
    // types where it is read. Effect's data types are immutable, but declare
    // `pipe` as a method, which the rule cannot tell from a mutator.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": [
              "Request",
              "Response",
              "Headers",
              "ReadableStream",
              "AbortSignal",
              "Uint8Array"
            ]
          },
          {
            "from": "package",
            "package": "effect",
            "name": [
              "Effect",
              "Option",
              "None",
              "Some",
              "Result",
              "Success",
              "Failure",
              "Exit",
              "Cause",
              "Duration",
              "DateTime",
              "Utc",
              "Zoned",
              "Ref",
              "SynchronizedRef",
              "Deferred",
              "Fiber",
              "Scope",
              "Closeable",
              "Layer",
              "Stream",
              "Sink",
              "Schedule",
              "HashSet",
              "HashMap",
              "Chunk",
              "Context",
              "Redacted",
              "Queue",
              "Latch",
              "Semaphore",
              "FileSystem",
              "File",
              "Path",
              "Stdio",
              "ChildProcessSpawner",
              "ChildProcessHandle",
              "Crypto",
              "PlatformError",
              "SystemError",
              "BadArgument",
              "SchemaError",
              "Issue",
              "HttpClientRequest",
              "Command",
              "StandardCommand",
              "PipedCommand",
              "HttpClientResponse",
              "ConfigError",
              "Json"
            ]
          },
          {
            "from": "package",
            "package": "@opencode/plugin",
            "name": [
              "CommandEditor",
              "CommandInvocation",
              "Context",
              "IntegrationEditor",
              "ModelEditor",
              "PermissionEvaluation",
              "PluginOptions",
              "SessionCompaction",
              "SessionContext",
              "SessionGenerate",
              "SessionHttpRequest",
              "SessionHttpResponse",
              "SessionTitle",
              "StorageDomain",
              "ToolEditor"
            ]
          },
          {
            "from": "package",
            "package": "@opencode/schema",
            "name": [
              "AgentSelected",
              "Assistant",
              "AssistantContent",
              "AssistantReasoning",
              "AssistantRetry",
              "AssistantText",
              "AssistantTool",
              "Compaction",
              "CompactionCompleted",
              "CompactionFailed",
              "CompactionRunning",
              "Context",
              "ID",
              "Idle",
              "Info",
              "Key",
              "LocationSwitched",
              "ModelSelected",
              "OAuth",
              "Ref",
              "Shell",
              "Skill",
              "Synthetic",
              "System",
              "ToolState",
              "ToolStateCompleted",
              "ToolStateError",
              "ToolStateRunning",
              "ToolStateStreaming",
              "User"
            ]
          }
        ]
      }
    ],

    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error"
  },
  "overrides": [
    {
      // Environment: oc-browser's extension runs in Chrome, not Node. Its
      // service worker starts its program with one top-level
      // `Effect.runFork` call, which these rules otherwise require to sit in
      // a test hook.
      "files": ["packages/oc-browser/extension/**"],
      "env": { "browser": true, "node": false, "webextensions": true },
      "rules": {
        "jest/require-hook": [
          "error",
          { "allowedFunctionCalls": ["Effect.runFork"] }
        ],
        "vitest/require-hook": [
          "error",
          { "allowedFunctionCalls": ["Effect.runFork"] }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**",
    "tools/oxlint/anti-slop/**"
  ]
}
