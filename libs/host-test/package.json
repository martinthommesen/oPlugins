{
  "name": "@oc-lib/host-test",
  "version": "0.1.0",
  "private": true,
  "description": "The headless host test: packs a plugin, installs it with a given OpenCode CLI in a sandbox, and checks that the host starts it.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
