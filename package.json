{
  "name": "oc-plugins",
  "private": true,
  "description": "OpenCode v2 plugins.",
  "type": "module",
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run lint:effect && pnpm run test",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "lint:effect": "pnpm -r run lint:effect",
    "format": "oxfmt --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@oxlint/plugins": "1.87.0",
    "effect": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2"
}
