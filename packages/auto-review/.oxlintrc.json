{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every built-in plugin and every category, nursery included, at error.
  // Deviations below are limited to two kinds, each with its reason:
  // a rule turned off because it contradicts another enabled rule or the
  // OpenCode host contract, and an option that declares this project's
  // environment (test blocks, library constructors, host types) to a rule.
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "jest",
    "vitest",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "rules": {
    // Host contract: OpenCode loads a plugin from its entry module's default
    // export.
    "import/no-default-export": "off",
    // Contradiction: vitest/prefer-importing-vitest-globals requires the
    // opposite. Effect's `it.effect` exists only as an import.
    "vitest/no-importing-vitest-globals": "off",
    // Contradiction: test functions can be imported from one source only, and
    // vitest/prefer-importing-vitest-globals requires that source to be Vitest.
    "jest/prefer-importing-jest-globals": "off",
    // Contradiction: vitest/prefer-strict-boolean-matchers requires
    // `toBe(true)` and `toBe(false)`; these two require the opposite.
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-to-be-falsy": "off",
    // Contradiction: the Effect skill's module pattern exports a schema and
    // its same-name type, tagged errors, and service classes from the owning
    // module. A default-only module cannot export a value and a type together.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // Contradiction: Effect workflows bind each `yield*` step in its own
    // statement, and anti-slop/require-readable-spacing separates statements
    // by role. One declaration per scope would merge every step of a workflow
    // into a single statement.
    "eslint/one-var": "off",
    // Contradiction: the same Effect pattern declares a schema value and a
    // same-name type. TypeScript merges the two; this rule does not model
    // declaration merging, and `tsc` already rejects real redeclarations.
    "eslint/no-redeclare": "off",
    // Contradiction: typescript/promise-function-async requires `async` on
    // every promise-returning function; oxc/no-async-await forbids it.
    "oxc/no-async-await": "off",
    // Contradiction: the untyped base rule reports an `async` function that
    // returns a promise without awaiting it, which
    // typescript/promise-function-async requires. The type-aware
    // typescript/require-await stays on and accepts that case.
    "eslint/require-await": "off",
    // Contradiction: false positive on the class factories the Effect rules
    // require (`class E extends Schema.TaggedError<E>()(...)`), which are
    // calls in a heritage clause, not throws.
    "unicorn/throw-new-error": "off",

    // Environment: the Effect skill pairs each `Schema.Struct` with a
    // same-name `interface X extends Schema.Schema.Type<typeof X> {}`.
    "typescript/no-empty-interface": ["error", { "allowSingleExtends": true }],
    "typescript/no-empty-object-type": [
      "error",
      { "allowInterfaces": "with-single-extends" }
    ],

    // Environment: Effect's constructors are capitalized functions by design
    // (`Schema.Struct(...)`, `Context.Service<...>()`), as are the variant
    // constructors of this project's `Data.taggedEnum` types, and the Effect
    // rules below require using them.
    "eslint/new-cap": [
      "error",
      {
        "capIsNewExceptionPattern": "^(?:Schema|Context|Data|Config|ConfigProvider|Layer|Effect|Stream|Schedule|Duration|Option|Result|Exit|Cause|Match|Predicate|Struct|Encoding|Order|Equivalence|Redacted|HttpClient|HttpClientRequest|HttpClientResponse|Sse|ConversationItem|BreakerDecision|Verdict)\\."
      }
    ],
    // Environment: vitest/prefer-describe-function-title requires passing the
    // function under test as the `describe` title, which Vitest accepts.
    "jest/valid-title": ["error", { "ignoreTypeOfDescribeName": true }],
    "vitest/valid-title": ["error", { "ignoreTypeOfDescribeName": true }],
    // Environment: `@effect/vitest` test blocks.
    "jest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "it.live", "layer"] }
    ],
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "it.live", "layer"] }
    ],

    // Environment: the host hands the permission hook an event object whose
    // contract is to be mutated in place (`event.effect = ...`), and the
    // plugin context is a host-owned handle, so neither can be declared
    // deeply readonly.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@opencode/plugin",
            "name": ["PermissionEvaluation", "Context"]
          },
          // Session messages and credentials decoded by the host. Each is
          // converted to this plugin's readonly types where it is read.
          {
            "from": "package",
            "package": "@opencode/schema",
            "name": [
              "AgentSelected",
              "Assistant",
              "AssistantReasoning",
              "AssistantRetry",
              "AssistantText",
              "AssistantTool",
              "CompactionCompleted",
              "CompactionFailed",
              "CompactionRunning",
              "Idle",
              "Key",
              "LocationSwitched",
              "ModelSelected",
              "OAuth",
              "Shell",
              "Skill",
              "Synthetic",
              "System",
              "ToolStateCompleted",
              "ToolStateError",
              "ToolStateRunning",
              "ToolStateStreaming",
              "User"
            ]
          },
          // This project's tagged errors extend the platform `Error`, whose
          // `message` and `stack` are writable.
          {
            "from": "file",
            "name": [
              "AuthUnavailable",
              "HostError",
              "MalformedAssessment",
              "ModelUnavailable",
              "RequestFailed",
              "ReviewTimedOut"
            ]
          },
          // Effect's data types are immutable by contract, but their
          // interfaces carry members the rule cannot prove readonly.
          {
            "from": "package",
            "package": "effect",
            "name": [
              "Duration",
              "Effect",
              "HashMap",
              "HttpClientRequest",
              "HttpClientResponse",
              "Option",
              "Redacted",
              "Ref",
              "Stream",
              "Uint8Array"
            ]
          }
        ]
      }
    ],
    // Environment: consistent-type-specifier-style requires a separate
    // `import type` statement when a module provides both types and values.
    "eslint/no-duplicate-imports": [
      "error",
      { "allowSeparateTypeImports": true }
    ],

    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error"
  },
  "overrides": [
    {
      // Environment: maintenance scripts run once under Node, outside the
      // plugin. Top-level statements are the script, not test setup.
      "files": ["scripts/**"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "jest/require-hook": "off",
        "vitest/require-hook": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ]
}
