{
  "name": "opencode-auto-review",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCode v2 plugin that routes permission prompts through a reviewer model before asking the user.",
  "keywords": [
    "auto-review",
    "opencode",
    "permissions",
    "plugin"
  ],
  "files": [
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/testing.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "vendor:codex": "node scripts/vendor-codex-policy.ts && oxfmt --write src/vendor/codex/policy.ts",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@opencode/plugin": "catalog:",
    "@opencode/schema": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26",
    "effect": "^4.0.0-rc.112"
  }
}
