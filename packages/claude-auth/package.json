{
  "name": "opencode-claude-auth",
  "version": "3.0.0",
  "description": "OpenCode v2 plugin for Claude Code subscription credentials.",
  "keywords": [
    "anthropic",
    "auth",
    "claude",
    "opencode",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/griffinmartin/opencode-claude-auth.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "test:headless": "pnpm run build && node --experimental-strip-types scripts/test-headless.ts",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "prepublishOnly": "pnpm run lint && pnpm run build && pnpm test && pnpm pack --dry-run"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18381"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
