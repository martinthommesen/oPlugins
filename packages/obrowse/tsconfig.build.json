{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test-support.ts"]
}
