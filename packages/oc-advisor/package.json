{
  "name": "@martinthommesen/oc-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode v2 plugin that lets agents consult a configurable advisor model for a second opinion.",
  "keywords": [
    "opencode",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinthommesen/oc-plugins.git",
    "directory": "packages/oc-advisor"
  },
  "files": [
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@opencode/plugin": "catalog:",
    "@opencode/schema": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
