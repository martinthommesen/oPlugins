{
  "name": "@martinthommesen/oc-auto",
  "version": "0.1.0",
  "description": "OpenCode v2 plugin that routes permission prompts through a reviewer model before asking the user.",
  "keywords": [
    "auto-review",
    "opencode",
    "permissions",
    "plugin"
  ],
  "license": "MIT",
  "author": "Martin Lammetun Thommesen <267603464+martinthommesen@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinthommesen/oc-plugins.git",
    "directory": "packages/oc-auto"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:host": "pnpm run build && node --experimental-strip-types scripts/test-host.ts",
    "verify:dist": "node -e \"import('./dist/index.js').then(m => { if (!m.default?.id) { throw new Error('dist/index.js does not export a plugin') } })\"",
    "prepublishOnly": "pnpm run --workspace-root lint && pnpm run typecheck && pnpm run lint:effect && pnpm run build && pnpm test && pnpm run verify:dist && pnpm pack --dry-run",
    "vendor:codex": "node scripts/vendor-codex-policy.ts && oxfmt --write src/vendor/codex/policy.ts",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@oc-lib/captured-logs": "workspace:*",
    "@oc-lib/host-test": "workspace:*",
    "@oc-lib/log-redaction": "workspace:*",
    "@oc-lib/plugin-options": "workspace:*",
    "@opencode/plugin": "catalog:",
    "@opencode/schema": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "engines": {
    "opencode": ">=2.0.26"
  }
}
