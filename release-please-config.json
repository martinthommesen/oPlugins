    },
    "packages/oc-auto": {
      "component": "oc-auto",
      "package-name": "@martinthommesen/oc-auto"
    },
    "packages/oc-browser": {
      "component": "oc-browser",
      "package-name": "@martinthommesen/oc-browser"
    },
    "packages/oc-usage": {
      "component": "oc-usage",
      "package-name": "@martinthommesen/oc-usage"
    }
  }
}
